  "path_cases": [
    {
      "id": "absolute-drive",
      "relative_path": "C:/outside.py",
      "expected_error": "DOCUMENT_PATH_INVALID"
    },
    {
      "id": "absolute-root",
      "relative_path": "/outside.py",
      "expected_error": "DOCUMENT_PATH_INVALID"
    },
    {
      "id": "alternate-stream",
      "relative_path": "pkg/module.py:stream",
      "expected_error": "DOCUMENT_PATH_INVALID"
    },
    {
      "id": "backslash",
      "relative_path": "pkg\\module.py",
      "expected_error": "DOCUMENT_PATH_INVALID"
    },
    {
      "id": "current-component",
      "relative_path": "pkg/./module.py",
      "expected_error": "DOCUMENT_PATH_INVALID"
    },
    {
      "id": "double-separator",
      "relative_path": "pkg//module.py",
      "expected_error": "DOCUMENT_PATH_INVALID"
    },
    {
      "id": "empty",
      "relative_path": "",
      "expected_error": "DOCUMENT_PATH_INVALID"
    },
    {
      "id": "parent-traversal",
      "relative_path": "../outside.py",
      "expected_error": "DOCUMENT_PATH_INVALID"
    }
