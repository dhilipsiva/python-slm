{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://python-slm.local/schemas/P0A/python-slm-p0a-phase-evidence-v1.schema.json",
  "title": "python-slm immutable P0A machine evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase_id",
    "interface_id",
    "profile_id",
    "run_id",
    "status",
    "generated_at_utc",
    "source",
    "p0_dependency",
    "artifacts",
    "commands",
    "authority",
    "errors",
    "seal"
  ],
  "properties": {
    "schema": { "const": "python-slm-p0a-phase-evidence-v1" },
    "phase_id": { "const": "P0A" },
    "interface_id": { "const": "portable-interface-v2" },
    "profile_id": { "const": "prototype-windows-5090-v1" },
    "run_id": { "$ref": "#/definitions/runId" },
    "status": { "enum": ["AWAITING_REVIEW", "FAIL"] },
    "generated_at_utc": { "$ref": "#/definitions/utcDateTime" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "branch", "dirty", "cargo_lock_sha256", "identity_ref"],
      "properties": {
        "commit": { "$ref": "#/definitions/gitSha" },
        "tree": { "$ref": "#/definitions/gitSha" },
        "branch": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" },
        "cargo_lock_sha256": { "$ref": "#/definitions/sha256" },
        "identity_ref": { "$ref": "#/definitions/fileRef" }
      }
    },
    "p0_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "baseline_commit",
        "receipt_commit",
        "receipt_sha256",
        "contract_sha256",
        "decision_ledger_sha256",
        "reconciliation_commit",
        "reconciliation_tree",
        "run_id",
        "seal_sha256",
        "historical_cargo_lock_sha256",
        "oracle_commit",
        "oracle_normalized_sha256",
        "reference"
      ],
      "properties": {
        "status": { "const": "PASS" },
        "baseline_commit": { "const": "b1ebb455cdae94bbb9fc54f246cdf2758eedf1d1" },
        "receipt_commit": { "const": "86fb1e4cc68efeb651e5362c4aca85c2827d8e4d" },
        "receipt_sha256": { "const": "f08c6a41658ff287e238d6a96c4f2c874975964202c3eeced2bc0bc21f308904" },
        "contract_sha256": { "const": "fc2c60b52fdd7c524e0da06bb03972a4d523c21ad5536cba536185435bd44ad4" },
        "decision_ledger_sha256": { "const": "8349d8a3e06d96d6921889de5534715e7b2f7439caf7e06558a97652a8890c8d" },
        "reconciliation_commit": { "const": "245f5f71eb3a76b3ce8e7c42228c00167803947c" },
        "reconciliation_tree": { "const": "c7a322bc77aebab6a5117708f2b74d34365c7336" },
        "run_id": { "const": "20260811T074740Z-d5008e94" },
        "seal_sha256": { "const": "184dc926bb9e5e2963a61182398580f7dedbf5aa5992f062dacfc6db6f1430f5" },
        "historical_cargo_lock_sha256": { "const": "c0a5e1afe02e252a22cca8bf07ab37fb2a25844210d2d5ce2e1e6082e497a28c" },
        "oracle_commit": { "const": "804cdcec24996895c469f54593a5aa79a4cd706a" },
        "oracle_normalized_sha256": { "const": "ffaa3b309e31782c95bfed1d4c37eb4b56427bc878c3d796f99d8663de53fe46" },
        "reference": {
          "allOf": [
            { "$ref": "#/definitions/fileRef" },
            { "properties": { "path": { "const": "artifacts/p0-dependency.json" } } }
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/fileRef" },
      "allOf": [
        { "contains": { "properties": { "path": { "const": "artifacts/rebuild-contract-v2.md" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "artifacts/decision-ledger-v2.md" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "artifacts/0000-prototype-first-portable-interface.md" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "artifacts/ARCHITECTURE.md" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "artifacts/AGENTS.md" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "artifacts/TODO-preapproval.md" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "artifacts/Cargo.lock" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "artifacts/p0-dependency.json" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "artifacts/source-identity.json" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "artifacts/schema-bundle.json" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "artifacts/parser-boundary.json" } }, "required": ["path"] } }
      ]
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv", "cwd", "exit_code", "status", "stdout", "stderr"],
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]{2,4}$" },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "cwd": { "const": "${REPO}" },
          "exit_code": { "type": "integer" },
          "status": { "enum": ["PASS", "FAIL"] },
          "stdout": { "$ref": "#/definitions/fileRef" },
          "stderr": { "$ref": "#/definitions/fileRef" }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine_evidence", "phase_acceptance", "required_approvals"],
      "properties": {
        "machine_evidence": { "enum": ["PASS", "FAIL"] },
        "phase_acceptance": { "const": "PENDING" },
        "required_approvals": { "const": ["technical", "data_governance"] }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "category", "message", "remediation"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "category": { "type": "integer", "minimum": 1, "maximum": 5 },
          "message": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "entries", "coverage_rule"],
      "properties": {
        "path": { "const": "SHA256SUMS" },
        "entries": { "type": "integer", "minimum": 1 },
        "coverage_rule": { "const": "all_run_files_except_seal" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "AWAITING_REVIEW" } }, "required": ["status"] },
      "then": {
        "properties": {
          "source": { "properties": { "dirty": { "const": false } } },
          "authority": { "properties": { "machine_evidence": { "const": "PASS" } } },
          "errors": { "maxItems": 0 },
          "commands": { "items": { "properties": { "exit_code": { "const": 0 }, "status": { "const": "PASS" } } } }
        }
      },
      "else": {
        "properties": {
          "authority": { "properties": { "machine_evidence": { "const": "FAIL" } } },
          "errors": { "minItems": 1 }
        }
      }
    }
  ],
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}$" },
    "utcDateTime": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "$ref": "#/definitions/relativePath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
