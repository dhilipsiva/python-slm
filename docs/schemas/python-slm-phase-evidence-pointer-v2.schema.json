{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://python-slm.local/schemas/python-slm-phase-evidence-pointer-v2.schema.json",
  "title": "python-slm selected P1B evidence pointer v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase_id",
    "acceptance_path",
    "acceptance_sha256",
    "updated_at"
  ],
  "properties": {
    "schema": { "const": "python-slm-phase-evidence-pointer-v2" },
    "phase_id": { "const": "P1B" },
    "acceptance_path": {
      "type": "string",
      "pattern": "^acceptances/[0-9]{8}\\.json$"
    },
    "acceptance_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "updated_at": { "$ref": "#/definitions/utcDateTime" }
  },
  "definitions": {
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
