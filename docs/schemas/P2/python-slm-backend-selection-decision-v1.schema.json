{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://python-slm.local/schemas/P2/python-slm-backend-selection-decision-v1.schema.json",
  "title": "python-slm provisional Phase 2 backend selection decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "phase_id", "policy_id", "status", "owner_review_status", "selected_candidate_id", "selection_criterion", "passing_frameworks", "rejected_candidates", "diagnostic_fallback", "qualification_run_id", "limitations"],
  "properties": {
    "schema": { "const": "python-slm-backend-selection-decision-v1" },
    "phase_id": { "const": "P2" },
    "policy_id": { "const": "backend-qualification-v1" },
    "status": { "enum": ["PASS", "FAIL"] },
    "owner_review_status": { "const": "AWAITING_REVIEW" },
    "selected_candidate_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/frameworkId" }] },
    "selection_criterion": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["only_passing_framework", "geomean_fwbw_p50_ns", "geomean_fwbw_p95_ns", "observed_peak_bytes", "locked_dependency_count", "stable_candidate_id"] }
      ]
    },
    "passing_frameworks": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/definitions/frameworkId" } },
    "rejected_candidates": { "$ref": "#/definitions/rejectedCandidates" },
    "diagnostic_fallback": { "$ref": "#/definitions/diagnosticFallback" },
    "qualification_run_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}$" },
    "limitations": {
      "const": [
        "primitive_bf16_training_viability_only",
        "transformer_layer_parity_deferred_to_P10",
        "full_optimizer_step_deferred_to_P12",
        "no_vram_fit_claim",
        "no_tokens_per_second_claim",
        "no_eight_hour_feasibility_claim"
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
      "then": {
        "properties": {
          "selected_candidate_id": { "$ref": "#/definitions/frameworkId" },
          "selection_criterion": { "enum": ["only_passing_framework", "geomean_fwbw_p50_ns", "geomean_fwbw_p95_ns", "observed_peak_bytes", "locked_dependency_count", "stable_candidate_id"] },
          "passing_frameworks": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/definitions/frameworkId" } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "FAIL" } }, "required": ["status"] },
      "then": {
        "properties": {
          "selected_candidate_id": { "type": "null" }, "selection_criterion": { "type": "null" }, "passing_frameworks": { "type": "array", "maxItems": 0 },
          "rejected_candidates": { "type": "array", "minItems": 2, "maxItems": 2, "items": [{ "$ref": "#/definitions/rejectedBurn" }, { "$ref": "#/definitions/rejectedCandle" }], "additionalItems": false }
        }
      }
    }
  ],
  "definitions": {
    "frameworkId": { "type": "string", "enum": ["burn-cubecl", "candle"] },
    "safeString": { "type": "string", "minLength": 1, "pattern": "^(?!.*(?:[A-Za-z]:[\\\\/]|\\\\\\\\))[^\\r\\n]+$" },
    "rejectedCandidate": {
      "type": "object", "additionalProperties": false, "required": ["candidate_id", "reason_codes"],
      "properties": {
        "candidate_id": { "$ref": "#/definitions/frameworkId" },
        "reason_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
      }
    },
    "rejectedBurn": { "allOf": [{ "$ref": "#/definitions/rejectedCandidate" }, { "properties": { "candidate_id": { "const": "burn-cubecl" } } }] },
    "rejectedCandle": { "allOf": [{ "$ref": "#/definitions/rejectedCandidate" }, { "properties": { "candidate_id": { "const": "candle" } } }] },
    "rejectedCandidates": {
      "oneOf": [
        { "type": "array", "maxItems": 0 },
        { "type": "array", "minItems": 1, "maxItems": 1, "items": [{ "$ref": "#/definitions/rejectedBurn" }], "additionalItems": false },
        { "type": "array", "minItems": 1, "maxItems": 1, "items": [{ "$ref": "#/definitions/rejectedCandle" }], "additionalItems": false },
        { "type": "array", "minItems": 2, "maxItems": 2, "items": [{ "$ref": "#/definitions/rejectedBurn" }, { "$ref": "#/definitions/rejectedCandle" }], "additionalItems": false }
      ]
    },
    "diagnosticFallback": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason"],
      "properties": { "status": { "enum": ["NOT_RUN", "PASS", "FAIL"] }, "reason": { "$ref": "#/definitions/safeString" } }
    }
  }
}
