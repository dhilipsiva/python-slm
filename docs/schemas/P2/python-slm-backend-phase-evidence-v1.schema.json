{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://python-slm.local/schemas/P2/python-slm-backend-phase-evidence-v1.schema.json",
  "title": "python-slm immutable Phase 2 backend qualification evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "phase_id", "run_id", "status", "owner_review_status", "started_at", "finished_at", "duration_ms", "invocation", "source_identity_sha256", "p1b_dependency", "policy", "dependency_inventory", "fixture_manifest", "host_state", "candidates", "comparison", "decision", "cpu_isolation", "commands", "gates", "errors", "cleanup", "seal"],
  "properties": {
    "schema": { "const": "python-slm-backend-phase-evidence-v1" },
    "phase_id": { "const": "P2" },
    "run_id": { "$ref": "#/definitions/runId" },
    "status": { "enum": ["PASS", "FAIL"] },
    "owner_review_status": { "const": "AWAITING_REVIEW" },
    "started_at": { "$ref": "#/definitions/utc" }, "finished_at": { "$ref": "#/definitions/utc" }, "duration_ms": { "type": "integer", "minimum": 0 },
    "invocation": { "$ref": "#/definitions/invocation" }, "source_identity_sha256": { "$ref": "#/definitions/sha256" },
    "p1b_dependency": { "$ref": "#/definitions/p1bDependency" },
    "policy": { "$ref": "#/definitions/policyRef" }, "dependency_inventory": { "$ref": "#/definitions/dependencyRef" },
    "fixture_manifest": { "$ref": "#/definitions/fixtureRef" }, "host_state": { "$ref": "#/definitions/hostRef" },
    "candidates": { "$ref": "#/definitions/recordedCandidateRefs" },
    "comparison": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/comparisonRef" }] },
    "decision": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/decisionRef" }] },
    "cpu_isolation": { "$ref": "#/definitions/cpuIsolationRef" },
    "commands": { "type": "array", "items": { "$ref": "#/definitions/command" } },
    "gates": { "$ref": "#/definitions/gates" },
    "errors": { "type": "array", "items": { "$ref": "#/definitions/error" } },
    "cleanup": { "$ref": "#/definitions/cleanup" }, "seal": { "$ref": "#/definitions/seal" }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
    "then": { "properties": {
      "p1b_dependency": { "$ref": "#/definitions/passingP1BDependency" }, "comparison": { "$ref": "#/definitions/comparisonRef" },
      "decision": { "$ref": "#/definitions/passingDecisionRef" }, "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/passingCommand" } },
      "candidates": { "$ref": "#/definitions/passingCandidateRefs" }, "gates": { "$ref": "#/definitions/passingGates" }, "errors": { "type": "array", "maxItems": 0 }, "cleanup": { "$ref": "#/definitions/passingCleanup" }
    } },
    "else": { "properties": { "errors": { "type": "array", "minItems": 1 } } }
  }],
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nullableSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/sha256" }] },
    "runId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}$" },
    "utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "safeString": { "type": "string", "minLength": 1, "pattern": "^(?!.*(?:[A-Za-z]:[\\\\/]|\\\\\\\\))[^\\r\\n]+$" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$" },
    "fileRef": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": { "path": { "$ref": "#/definitions/relativePath" }, "sha256": { "$ref": "#/definitions/sha256" }, "bytes": { "type": "integer", "minimum": 0 } } },
    "policyRef": { "allOf": [{ "$ref": "#/definitions/fileRef" }, { "properties": { "path": { "const": "artifacts/qualification-policy.json" } } }] },
    "dependencyRef": { "allOf": [{ "$ref": "#/definitions/fileRef" }, { "properties": { "path": { "const": "artifacts/dependency-inventory.json" } } }] },
    "fixtureRef": { "allOf": [{ "$ref": "#/definitions/fileRef" }, { "properties": { "path": { "const": "artifacts/fixture-manifest.json" } } }] },
    "hostRef": { "allOf": [{ "$ref": "#/definitions/fileRef" }, { "properties": { "path": { "const": "artifacts/host-state.json" } } }] },
    "comparisonRef": { "allOf": [{ "$ref": "#/definitions/fileRef" }, { "properties": { "path": { "const": "artifacts/comparison.json" } } }] },
    "decisionRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "status", "selected_candidate_id", "owner_review_status"],
      "properties": {
        "path": { "const": "artifacts/decision.json" }, "sha256": { "$ref": "#/definitions/sha256" }, "bytes": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["PASS", "FAIL"] }, "selected_candidate_id": { "oneOf": [{ "type": "null" }, { "enum": ["burn-cubecl", "candle"] }] },
        "owner_review_status": { "const": "AWAITING_REVIEW" }
      }
    },
    "passingDecisionRef": { "allOf": [{ "$ref": "#/definitions/decisionRef" }, { "properties": { "status": { "const": "PASS" }, "selected_candidate_id": { "enum": ["burn-cubecl", "candle"] } } }] },
    "cpuIsolationRef": { "allOf": [{ "$ref": "#/definitions/fileRef" }, { "properties": { "path": { "const": "artifacts/cpu-isolation.json" } } }] },
    "candidateRef": {
      "type": "object", "additionalProperties": false, "required": ["candidate_id", "role", "status", "path", "sha256", "bytes"],
      "properties": {
        "candidate_id": { "enum": ["burn-cubecl", "candle", "cudarc-fallback"] }, "role": { "enum": ["framework", "diagnostic_fallback"] }, "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "path": { "type": "string", "pattern": "^artifacts/(burn-cubecl|candle|cudarc-fallback)\\.json$" }, "sha256": { "$ref": "#/definitions/sha256" }, "bytes": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        { "if": { "properties": { "candidate_id": { "const": "burn-cubecl" } }, "required": ["candidate_id"] }, "then": { "properties": { "role": { "const": "framework" }, "path": { "const": "artifacts/burn-cubecl.json" } } } },
        { "if": { "properties": { "candidate_id": { "const": "candle" } }, "required": ["candidate_id"] }, "then": { "properties": { "role": { "const": "framework" }, "path": { "const": "artifacts/candle.json" } } } },
        { "if": { "properties": { "candidate_id": { "const": "cudarc-fallback" } }, "required": ["candidate_id"] }, "then": { "properties": { "role": { "const": "diagnostic_fallback" }, "path": { "const": "artifacts/cudarc-fallback.json" } } } },
        { "properties": { "sha256": { "$ref": "#/definitions/sha256" }, "bytes": { "type": "integer", "minimum": 1 } } }
      ]
    },
    "burnCandidateRef": { "allOf": [{ "$ref": "#/definitions/candidateRef" }, { "properties": { "candidate_id": { "const": "burn-cubecl" }, "role": { "const": "framework" }, "path": { "const": "artifacts/burn-cubecl.json" } } }] },
    "candleCandidateRef": { "allOf": [{ "$ref": "#/definitions/candidateRef" }, { "properties": { "candidate_id": { "const": "candle" }, "role": { "const": "framework" }, "path": { "const": "artifacts/candle.json" } } }] },
    "fallbackCandidateRef": { "allOf": [{ "$ref": "#/definitions/candidateRef" }, { "properties": { "candidate_id": { "const": "cudarc-fallback" }, "role": { "const": "diagnostic_fallback" }, "path": { "const": "artifacts/cudarc-fallback.json" } } }] },
    "recordedCandidateRefs": {
      "oneOf": [
        { "type": "array", "minItems": 2, "maxItems": 2, "items": [{ "$ref": "#/definitions/burnCandidateRef" }, { "$ref": "#/definitions/candleCandidateRef" }], "additionalItems": false },
        { "type": "array", "minItems": 3, "maxItems": 3, "items": [{ "$ref": "#/definitions/burnCandidateRef" }, { "$ref": "#/definitions/candleCandidateRef" }, { "$ref": "#/definitions/fallbackCandidateRef" }], "additionalItems": false }
      ]
    },
    "passingCandidateRefs": {
      "allOf": [
        { "type": "array", "minItems": 2, "maxItems": 2, "items": [{ "$ref": "#/definitions/burnCandidateRef" }, { "$ref": "#/definitions/candleCandidateRef" }], "additionalItems": false },
        { "contains": { "properties": { "candidate_id": { "enum": ["burn-cubecl", "candle"] }, "status": { "const": "PASS" } }, "required": ["candidate_id", "status"] } },
        { "not": { "contains": { "properties": { "candidate_id": { "const": "cudarc-fallback" }, "status": { "enum": ["PASS", "FAIL"] } }, "required": ["candidate_id", "status"] } } }
      ]
    },
    "invocation": {
      "type": "object", "additionalProperties": false, "required": ["argv", "cwd"],
      "properties": { "argv": { "const": ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/qualify-backend.ps1", "-OutputRoot", "docs/receipts/P2"] }, "cwd": { "const": "${REPO}" } }
    },
    "p1bDependency": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "pointer_path", "pointer_sha256", "acceptance_path", "acceptance_sha256", "acceptance_sequence", "run_path", "run_evidence_sha256", "seal_path", "seal_sha256", "environment_path", "environment_sha256", "source_identity_sha256", "verifier_sha256", "schema_bundle_sha256", "review_closure_commit"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] }, "pointer_path": { "oneOf": [{ "type": "null" }, { "const": "docs/receipts/P1B/evidence.json" }] }, "pointer_sha256": { "$ref": "#/definitions/nullableSha256" },
        "acceptance_path": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^docs/receipts/P1B/acceptances/[0-9]{8}\\.json$" }] }, "acceptance_sha256": { "$ref": "#/definitions/nullableSha256" }, "acceptance_sequence": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
        "run_path": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^docs/receipts/P1B/runs/[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}$" }] }, "run_evidence_sha256": { "$ref": "#/definitions/nullableSha256" },
        "seal_path": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^docs/receipts/P1B/runs/[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}/SHA256SUMS$" }] }, "seal_sha256": { "$ref": "#/definitions/nullableSha256" },
        "environment_path": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^docs/receipts/P1B/runs/[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}/artifacts/environment\\.json$" }] }, "environment_sha256": { "$ref": "#/definitions/nullableSha256" },
        "source_identity_sha256": { "$ref": "#/definitions/nullableSha256" }, "verifier_sha256": { "$ref": "#/definitions/nullableSha256" }, "schema_bundle_sha256": { "$ref": "#/definitions/nullableSha256" },
        "review_closure_commit": { "oneOf": [{ "type": "null" }, { "const": "8c822e51956543e3fa52aaf1f295a6b517e0fd40" }] }
      }
    },
    "passingP1BDependency": { "allOf": [{ "$ref": "#/definitions/p1bDependency" }, { "properties": { "status": { "const": "PASS" }, "pointer_path": { "const": "docs/receipts/P1B/evidence.json" }, "pointer_sha256": { "$ref": "#/definitions/sha256" }, "acceptance_path": { "type": "string" }, "acceptance_sha256": { "$ref": "#/definitions/sha256" }, "acceptance_sequence": { "type": "integer", "minimum": 1 }, "run_path": { "type": "string" }, "run_evidence_sha256": { "$ref": "#/definitions/sha256" }, "seal_path": { "type": "string" }, "seal_sha256": { "$ref": "#/definitions/sha256" }, "environment_path": { "type": "string" }, "environment_sha256": { "$ref": "#/definitions/sha256" }, "source_identity_sha256": { "$ref": "#/definitions/sha256" }, "verifier_sha256": { "$ref": "#/definitions/sha256" }, "schema_bundle_sha256": { "$ref": "#/definitions/sha256" }, "review_closure_commit": { "const": "8c822e51956543e3fa52aaf1f295a6b517e0fd40" } } }] },
    "command": {
      "type": "object", "additionalProperties": false, "required": ["id", "argv", "cwd", "environment_delta_names", "configuration_sha256", "expected_exit_codes", "expectation_met", "exit_code", "duration_ms", "status", "stdout", "stderr"],
      "properties": {
        "id": { "type": "string", "pattern": "^C[0-9]{2,4}$" }, "argv": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/safeString" } }, "cwd": { "$ref": "#/definitions/safeString" },
        "environment_delta_names": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_()]*$" } },
        "configuration_sha256": { "$ref": "#/definitions/sha256" },
        "expected_exit_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer" } }, "expectation_met": { "type": "boolean" },
        "exit_code": { "oneOf": [{ "type": "null" }, { "type": "integer" }] }, "duration_ms": { "type": "integer", "minimum": 0 }, "status": { "enum": ["PASS", "FAIL", "TIMEOUT", "OOM", "CRASH"] },
        "stdout": { "$ref": "#/definitions/fileRef" }, "stderr": { "$ref": "#/definitions/fileRef" }
      }
    },
    "passingCommand": { "$ref": "#/definitions/command" },
    "gate": { "type": "object", "additionalProperties": false, "required": ["status", "detail"], "properties": { "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] }, "detail": { "$ref": "#/definitions/safeString" } } },
    "passingGate": { "allOf": [{ "$ref": "#/definitions/gate" }, { "properties": { "status": { "const": "PASS" } } }] },
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["p1b_dependency", "input_stability", "dependency_policy", "fixture_determinism", "cpu_isolation", "sm120_launch", "bf16_roundtrip", "correctness", "synchronization", "runtime_provenance", "measurement_validity", "redaction", "cleanup"],
      "properties": { "p1b_dependency": { "$ref": "#/definitions/gate" }, "input_stability": { "$ref": "#/definitions/gate" }, "dependency_policy": { "$ref": "#/definitions/gate" }, "fixture_determinism": { "$ref": "#/definitions/gate" }, "cpu_isolation": { "$ref": "#/definitions/gate" }, "sm120_launch": { "$ref": "#/definitions/gate" }, "bf16_roundtrip": { "$ref": "#/definitions/gate" }, "correctness": { "$ref": "#/definitions/gate" }, "synchronization": { "$ref": "#/definitions/gate" }, "runtime_provenance": { "$ref": "#/definitions/gate" }, "measurement_validity": { "$ref": "#/definitions/gate" }, "redaction": { "$ref": "#/definitions/gate" }, "cleanup": { "$ref": "#/definitions/gate" } }
    },
    "passingGates": {
      "type": "object", "additionalProperties": false,
      "required": ["p1b_dependency", "input_stability", "dependency_policy", "fixture_determinism", "cpu_isolation", "sm120_launch", "bf16_roundtrip", "correctness", "synchronization", "runtime_provenance", "measurement_validity", "redaction", "cleanup"],
      "properties": { "p1b_dependency": { "$ref": "#/definitions/passingGate" }, "input_stability": { "$ref": "#/definitions/passingGate" }, "dependency_policy": { "$ref": "#/definitions/passingGate" }, "fixture_determinism": { "$ref": "#/definitions/passingGate" }, "cpu_isolation": { "$ref": "#/definitions/passingGate" }, "sm120_launch": { "$ref": "#/definitions/passingGate" }, "bf16_roundtrip": { "$ref": "#/definitions/passingGate" }, "correctness": { "$ref": "#/definitions/passingGate" }, "synchronization": { "$ref": "#/definitions/passingGate" }, "runtime_provenance": { "$ref": "#/definitions/passingGate" }, "measurement_validity": { "$ref": "#/definitions/passingGate" }, "redaction": { "$ref": "#/definitions/passingGate" }, "cleanup": { "$ref": "#/definitions/passingGate" } }
    },
    "error": { "type": "object", "additionalProperties": false, "required": ["code", "category", "message", "remediation"], "properties": { "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "category": { "type": "integer", "minimum": 1, "maximum": 5 }, "message": { "$ref": "#/definitions/safeString" }, "remediation": { "$ref": "#/definitions/safeString" } } },
    "cleanup": { "type": "object", "additionalProperties": false, "required": ["attempted", "temporary_root_removed", "process_trees_terminated"], "properties": { "attempted": { "type": "boolean" }, "temporary_root_removed": { "type": "boolean" }, "process_trees_terminated": { "type": "boolean" } } },
    "passingCleanup": { "allOf": [{ "$ref": "#/definitions/cleanup" }, { "properties": { "attempted": { "const": true }, "temporary_root_removed": { "const": true }, "process_trees_terminated": { "const": true } } }] },
    "seal": { "type": "object", "additionalProperties": false, "required": ["path", "entries", "coverage_rule"], "properties": { "path": { "const": "SHA256SUMS" }, "entries": { "type": "integer", "minimum": 1 }, "coverage_rule": { "const": "all_run_files_except_seal" } } }
  }
}
