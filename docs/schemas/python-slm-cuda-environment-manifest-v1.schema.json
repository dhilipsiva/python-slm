{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://python-slm.local/schemas/python-slm-cuda-environment-manifest-v1.schema.json",
  "title": "python-slm CUDA environment manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase_id",
    "run_id",
    "mode",
    "status",
    "p0",
    "p1a",
    "source",
    "host",
    "rust",
    "visual_studio",
    "windows_sdk",
    "cuda_toolkit",
    "runtime_linkage",
    "optional_components",
    "driver",
    "gpu",
    "architecture_targets",
    "device_probe",
    "isolation",
    "cleanup"
  ],
  "properties": {
    "schema": { "const": "python-slm-cuda-environment-manifest-v1" },
    "phase_id": { "const": "P1B" },
    "run_id": { "$ref": "#/definitions/runId" },
    "mode": { "const": "Cuda" },
    "status": { "const": "PASS" },
    "p0": { "$ref": "#/definitions/p0Identity" },
    "p1a": { "$ref": "#/definitions/passingP1ADependency" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "dirty",
        "input_manifest_sha256",
        "cargo_lock_sha256",
        "verifier_sha256",
        "schema_bundle_sha256"
      ],
      "properties": {
        "head": { "$ref": "#/definitions/gitSha" },
        "dirty": { "type": "boolean" },
        "input_manifest_sha256": { "$ref": "#/definitions/sha256" },
        "cargo_lock_sha256": { "$ref": "#/definitions/sha256" },
        "verifier_sha256": { "$ref": "#/definitions/sha256" },
        "schema_bundle_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "host": { "$ref": "#/definitions/host" },
    "rust": { "$ref": "#/definitions/rust" },
    "visual_studio": { "$ref": "#/definitions/visualStudio" },
    "windows_sdk": { "$ref": "#/definitions/windowsSdk" },
    "cuda_toolkit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "root", "tools", "headers", "libraries", "runtime_dlls"],
      "properties": {
        "version": { "$ref": "#/definitions/toolkitVersion" },
        "root": { "const": "${CUDA_TOOLKIT}" },
        "tools": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": [
            { "$ref": "#/definitions/nvccTool" },
            { "$ref": "#/definitions/ptxasTool" },
            { "$ref": "#/definitions/fatbinaryTool" },
            { "$ref": "#/definitions/nvlinkTool" },
            { "$ref": "#/definitions/cuobjdumpTool" }
          ],
          "additionalItems": false
        },
        "headers": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": [
            { "$ref": "#/definitions/cudaHeader" },
            { "$ref": "#/definitions/cudaRuntimeHeader" },
            { "$ref": "#/definitions/cublasHeader" },
            { "$ref": "#/definitions/cublasLtHeader" }
          ],
          "additionalItems": false
        },
        "libraries": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": [
            { "$ref": "#/definitions/cudaLibrary" },
            { "$ref": "#/definitions/cudartLibrary" },
            { "$ref": "#/definitions/cublasLibrary" },
            { "$ref": "#/definitions/cublasLtLibrary" }
          ],
          "additionalItems": false
        },
        "runtime_dlls": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": [
            { "$ref": "#/definitions/cudartDll" },
            { "$ref": "#/definitions/cublasDll" },
            { "$ref": "#/definitions/cublasLtDll" }
          ],
          "additionalItems": false
        }
      }
    },
    "runtime_linkage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "active_provider", "staged_runtime_dlls"],
      "properties": {
        "mode": { "enum": ["hybrid", "shared"] },
        "active_provider": { "enum": ["display_driver", "toolkit_cudart"] },
        "staged_runtime_dlls": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/stagedRuntimeDll" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": { "const": "hybrid" },
            "active_provider": { "const": "display_driver" },
            "staged_runtime_dlls": {
              "minItems": 2,
              "maxItems": 2,
              "items": [
                { "$ref": "#/definitions/stagedCublasDll" },
                { "$ref": "#/definitions/stagedCublasLtDll" }
              ],
              "additionalItems": false
            }
          }
        },
        {
          "properties": {
            "mode": { "const": "shared" },
            "active_provider": { "const": "toolkit_cudart" },
            "staged_runtime_dlls": {
              "minItems": 3,
              "maxItems": 3,
              "items": [
                { "$ref": "#/definitions/stagedCudartDll" },
                { "$ref": "#/definitions/stagedCublasDll" },
                { "$ref": "#/definitions/stagedCublasLtDll" }
              ],
              "additionalItems": false
            }
          }
        }
      ]
    },
    "optional_components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cudnn", "nvrtc", "nvjitlink", "compute_sanitizer", "curand"],
      "properties": {
        "cudnn": { "$ref": "#/definitions/optionalComponent" },
        "nvrtc": { "$ref": "#/definitions/optionalComponent" },
        "nvjitlink": { "$ref": "#/definitions/optionalComponent" },
        "compute_sanitizer": { "$ref": "#/definitions/optionalComponent" },
        "curand": { "$ref": "#/definitions/optionalComponent" }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver_version", "cuda_umd_version", "nvidia_smi", "library"],
      "properties": {
        "driver_version": { "$ref": "#/definitions/dottedVersion" },
        "cuda_umd_version": { "$ref": "#/definitions/nonEmptySingleLine" },
        "nvidia_smi": {
          "allOf": [
            { "$ref": "#/definitions/tool" },
            { "properties": { "name": { "const": "nvidia-smi" } } }
          ]
        },
        "library": {
          "allOf": [
            { "$ref": "#/definitions/tool" },
            { "properties": { "name": { "const": "nvcuda" } } }
          ]
        }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "memory_total_bytes",
        "compute_capability_major",
        "compute_capability_minor"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "const": "NVIDIA GeForce RTX 5090" },
        "memory_total_bytes": { "type": "integer", "minimum": 1 },
        "compute_capability_major": { "const": 12 },
        "compute_capability_minor": { "const": 0 }
      }
    },
    "architecture_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sass",
        "ptx",
        "advertised_architectures",
        "advertised_code",
        "mixed",
        "ptx_only"
      ],
      "properties": {
        "sass": { "const": ["sm_120"] },
        "ptx": { "const": ["compute_120"] },
        "advertised_architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^compute_[0-9]+[a-z]?$" },
          "contains": { "const": "compute_120" }
        },
        "advertised_code": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sm_[0-9]+[a-z]?$" },
          "contains": { "const": "sm_120" }
        },
        "mixed": { "$ref": "#/definitions/mixedArtifact" },
        "ptx_only": { "$ref": "#/definitions/ptxOnlyArtifact" }
      }
    },
    "device_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "runtime_version",
        "driver_version",
        "cublas_version",
        "cublaslt_version",
        "mixed_result",
        "ptx_only_result",
        "sentinel",
        "target_match_count"
      ],
      "properties": {
        "source_sha256": { "$ref": "#/definitions/sha256" },
        "runtime_version": { "type": "integer", "minimum": 12080 },
        "driver_version": { "type": "integer", "minimum": 12080 },
        "cublas_version": { "type": "integer", "minimum": 1 },
        "cublaslt_version": { "type": "integer", "minimum": 1 },
        "mixed_result": { "const": "PASS" },
        "ptx_only_result": { "const": "PASS" },
        "sentinel": { "const": 42 },
        "target_match_count": { "const": 1 }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporary_root_absent_before",
        "temporary_root_outside_repository",
        "python_canaries",
        "canary_hits",
        "python_invoked"
      ],
      "properties": {
        "temporary_root_absent_before": { "const": true },
        "temporary_root_outside_repository": { "const": true },
        "python_canaries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptySingleLine" }
        },
        "canary_hits": { "type": "array", "maxItems": 0 },
        "python_invoked": { "const": false }
      }
    },
    "cleanup": { "$ref": "#/definitions/passingManifestCleanup" }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}$"
    },
    "commandId": { "type": "string", "pattern": "^C[0-9]{2,4}$" },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "toolkitVersion": {
      "type": "string",
      "pattern": "^(?:12\\.(?:[89]|[1-9][0-9]+)\\.[0-9]+|(?:1[3-9]|[2-9][0-9]|[1-9][0-9]{2,})\\.[0-9]+\\.[0-9]+)$"
    },
    "dottedVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}$"
    },
    "fourPartVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "nonEmptySingleLine": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "tokenizedPath": {
      "type": "string",
      "pattern": "^\\$\\{(?:REPO|OUTPUT_ROOT|TEMP|USERPROFILE|VS_INSTALL|VC_TOOLS|WINDOWS_KITS|WINDOWS|CARGO_HOME|RUSTUP_HOME|CUDA_TOOLKIT)\\}(?:/[A-Za-z0-9][A-Za-z0-9._+() -]*)*$"
    },
    "stagedRuntimeDll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "sha256"],
      "properties": {
        "component": { "enum": ["cudart", "cublas", "cublaslt"] },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "stagedCudartDll": {
      "allOf": [
        { "$ref": "#/definitions/stagedRuntimeDll" },
        { "properties": { "component": { "const": "cudart" } } }
      ]
    },
    "stagedCublasDll": {
      "allOf": [
        { "$ref": "#/definitions/stagedRuntimeDll" },
        { "properties": { "component": { "const": "cublas" } } }
      ]
    },
    "stagedCublasLtDll": {
      "allOf": [
        { "$ref": "#/definitions/stagedRuntimeDll" },
        { "properties": { "component": { "const": "cublaslt" } } }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/sha256" }
      ]
    },
    "nullableP1APointerPath": {
      "oneOf": [
        { "type": "null" },
        { "const": "docs/receipts/P1A/evidence.json" }
      ]
    },
    "nullableP1AAcceptancePath": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^docs/receipts/P1A/acceptances/[0-9]{8}\\.json$"
        }
      ]
    },
    "nullableP1ARunPath": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^docs/receipts/P1A/runs/[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}$"
        }
      ]
    },
    "nullableP1ARunEvidencePath": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^docs/receipts/P1A/runs/[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}/evidence\\.json$"
        }
      ]
    },
    "nullableP1ASealPath": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^docs/receipts/P1A/runs/[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}/SHA256SUMS$"
        }
      ]
    },
    "nullableP1AEnvironmentPath": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^docs/receipts/P1A/runs/[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}/artifacts/environment\\.json$"
        }
      ]
    },
    "p0Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_commit",
        "receipt_sha256",
        "contract_sha256",
        "decision_ledger_sha256"
      ],
      "properties": {
        "receipt_commit": { "$ref": "#/definitions/gitSha" },
        "receipt_sha256": { "$ref": "#/definitions/sha256" },
        "contract_sha256": { "$ref": "#/definitions/sha256" },
        "decision_ledger_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "p1aDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "pointer_path",
        "pointer_sha256",
        "acceptance_path",
        "acceptance_sha256",
        "acceptance_sequence",
        "run_path",
        "run_evidence_sha256",
        "seal_path",
        "seal_sha256",
        "environment_path",
        "environment_sha256",
        "source_identity_sha256",
        "verifier_sha256",
        "schema_bundle_sha256",
        "review_closure_commit"
      ],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "pointer_path": { "$ref": "#/definitions/nullableP1APointerPath" },
        "pointer_sha256": { "$ref": "#/definitions/nullableSha256" },
        "acceptance_path": { "$ref": "#/definitions/nullableP1AAcceptancePath" },
        "acceptance_sha256": { "$ref": "#/definitions/nullableSha256" },
        "acceptance_sequence": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1, "maximum": 99999999 }
          ]
        },
        "run_path": { "$ref": "#/definitions/nullableP1ARunPath" },
        "run_evidence_sha256": { "$ref": "#/definitions/nullableSha256" },
        "seal_path": { "$ref": "#/definitions/nullableP1ASealPath" },
        "seal_sha256": { "$ref": "#/definitions/nullableSha256" },
        "environment_path": { "$ref": "#/definitions/nullableP1AEnvironmentPath" },
        "environment_sha256": { "$ref": "#/definitions/nullableSha256" },
        "source_identity_sha256": { "$ref": "#/definitions/nullableSha256" },
        "verifier_sha256": { "$ref": "#/definitions/nullableSha256" },
        "schema_bundle_sha256": { "$ref": "#/definitions/nullableSha256" },
        "review_closure_commit": {
          "oneOf": [
            { "type": "null" },
            { "const": "9359c989fa63d4a300abc509e735b7e81a24a2ea" }
          ]
        }
      }
    },
    "passingP1ADependency": {
      "allOf": [
        { "$ref": "#/definitions/p1aDependency" },
        {
          "properties": {
            "status": { "const": "PASS" },
            "pointer_path": { "const": "docs/receipts/P1A/evidence.json" },
            "pointer_sha256": { "$ref": "#/definitions/sha256" },
            "acceptance_path": {
              "type": "string",
              "pattern": "^docs/receipts/P1A/acceptances/[0-9]{8}\\.json$"
            },
            "acceptance_sha256": { "$ref": "#/definitions/sha256" },
            "acceptance_sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999999
            },
            "run_path": {
              "type": "string",
              "pattern": "^docs/receipts/P1A/runs/[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}$"
            },
            "run_evidence_sha256": { "$ref": "#/definitions/sha256" },
            "seal_path": {
              "type": "string",
              "pattern": "^docs/receipts/P1A/runs/[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}/SHA256SUMS$"
            },
            "seal_sha256": { "$ref": "#/definitions/sha256" },
            "environment_path": {
              "type": "string",
              "pattern": "^docs/receipts/P1A/runs/[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}/artifacts/environment\\.json$"
            },
            "environment_sha256": { "$ref": "#/definitions/sha256" },
            "source_identity_sha256": { "$ref": "#/definitions/sha256" },
            "verifier_sha256": { "$ref": "#/definitions/sha256" },
            "schema_bundle_sha256": { "$ref": "#/definitions/sha256" },
            "review_closure_commit": {
              "const": "9359c989fa63d4a300abc509e735b7e81a24a2ea"
            }
          }
        }
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_version",
        "os_architecture",
        "process_architecture",
        "powershell_edition",
        "powershell_version"
      ],
      "properties": {
        "os_version": { "$ref": "#/definitions/nonEmptySingleLine" },
        "os_architecture": { "const": "AMD64" },
        "process_architecture": { "const": "AMD64" },
        "powershell_edition": { "const": "Desktop" },
        "powershell_version": {
          "type": "string",
          "pattern": "^5\\.1(?:\\.[0-9]+){0,2}$"
        }
      }
    },
    "rust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rustc_version",
        "commit_hash",
        "commit_date",
        "host",
        "llvm_version",
        "rustc",
        "cargo_version",
        "cargo",
        "rustup"
      ],
      "properties": {
        "rustc_version": { "$ref": "#/definitions/semanticVersion" },
        "commit_hash": { "$ref": "#/definitions/gitSha" },
        "commit_date": { "type": "string", "format": "date" },
        "host": { "const": "x86_64-pc-windows-msvc" },
        "llvm_version": { "$ref": "#/definitions/nonEmptySingleLine" },
        "rustc": {
          "allOf": [
            { "$ref": "#/definitions/tool" },
            { "properties": { "name": { "const": "rustc" } } }
          ]
        },
        "cargo_version": { "$ref": "#/definitions/semanticVersion" },
        "cargo": {
          "allOf": [
            { "$ref": "#/definitions/tool" },
            { "properties": { "name": { "const": "cargo" } } }
          ]
        },
        "rustup": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "active_toolchain", "installed_target", "components"],
              "properties": {
                "version": { "$ref": "#/definitions/nonEmptySingleLine" },
                "active_toolchain": { "$ref": "#/definitions/nonEmptySingleLine" },
                "installed_target": { "type": "boolean" },
                "components": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "$ref": "#/definitions/nonEmptySingleLine" }
                }
              }
            }
          ]
        }
      }
    },
    "visualStudio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_method",
        "query",
        "instance_id",
        "product_id",
        "product_version",
        "installation_version",
        "complete",
        "launchable",
        "reboot_required",
        "developer_environment_arguments",
        "tools"
      ],
      "properties": {
        "discovery_method": { "const": "vswhere" },
        "query": {
          "const": [
            "-version",
            "[17.0,18.0)",
            "-products",
            "*",
            "-requires",
            "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
            "-format",
            "json",
            "-utf8"
          ]
        },
        "instance_id": { "$ref": "#/definitions/nonEmptySingleLine" },
        "product_id": { "$ref": "#/definitions/nonEmptySingleLine" },
        "product_version": { "$ref": "#/definitions/nonEmptySingleLine" },
        "installation_version": {
          "type": "string",
          "pattern": "^17\\.[0-9]+(?:\\.[0-9]+){1,2}$"
        },
        "complete": { "const": true },
        "launchable": { "const": true },
        "reboot_required": { "const": false },
        "developer_environment_arguments": {
          "const": ["-arch=amd64", "-host_arch=amd64", "-startdir=none"]
        },
        "tools": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/tool" },
          "allOf": [
            { "contains": { "$ref": "#/definitions/clTool" } },
            { "contains": { "$ref": "#/definitions/linkTool" } },
            { "contains": { "$ref": "#/definitions/libTool" } },
            { "contains": { "$ref": "#/definitions/dumpbinTool" } }
          ]
        }
      }
    },
    "windowsSdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "ucrt_version", "root", "validated_paths", "tools"],
      "properties": {
        "version": { "$ref": "#/definitions/fourPartVersion" },
        "ucrt_version": { "$ref": "#/definitions/fourPartVersion" },
        "root": { "const": "${WINDOWS_KITS}" },
        "validated_paths": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": [
            { "type": "string", "pattern": "^\\$\\{WINDOWS_KITS\\}/Include/[0-9]+(?:\\.[0-9]+){3}/um/Windows\\.h$" },
            { "type": "string", "pattern": "^\\$\\{WINDOWS_KITS\\}/Include/[0-9]+(?:\\.[0-9]+){3}/ucrt/stdlib\\.h$" },
            { "type": "string", "pattern": "^\\$\\{WINDOWS_KITS\\}/Lib/[0-9]+(?:\\.[0-9]+){3}/um/x64/kernel32\\.lib$" },
            { "type": "string", "pattern": "^\\$\\{WINDOWS_KITS\\}/Lib/[0-9]+(?:\\.[0-9]+){3}/ucrt/x64/ucrt\\.lib$" },
            { "type": "string", "pattern": "^\\$\\{WINDOWS_KITS\\}/bin/[0-9]+(?:\\.[0-9]+){3}/x64/rc\\.exe$" },
            { "type": "string", "pattern": "^\\$\\{WINDOWS_KITS\\}/bin/[0-9]+(?:\\.[0-9]+){3}/x64/mt\\.exe$" }
          ],
          "additionalItems": false
        },
        "tools": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/tool" },
          "allOf": [
            { "contains": { "$ref": "#/definitions/rcTool" } },
            { "contains": { "$ref": "#/definitions/mtTool" } }
          ]
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "path", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "version": { "$ref": "#/definitions/nonEmptySingleLine" },
        "path": { "$ref": "#/definitions/tokenizedPath" },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256", "bytes"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" },
        "path": { "$ref": "#/definitions/tokenizedPath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "optionalComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "version", "path", "sha256"],
      "properties": {
        "present": { "type": "boolean" },
        "version": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/nonEmptySingleLine" }
          ]
        },
        "path": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/tokenizedPath" }
          ]
        },
        "sha256": { "$ref": "#/definitions/nullableSha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "present": { "const": true } },
            "required": ["present"]
          },
          "then": {
            "properties": {
              "path": { "$ref": "#/definitions/tokenizedPath" },
              "sha256": { "$ref": "#/definitions/sha256" }
            }
          },
          "else": {
            "properties": {
              "version": { "type": "null" },
              "path": { "type": "null" },
              "sha256": { "type": "null" }
            }
          }
        }
      ]
    },
    "artifactInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compile_command_id",
        "executable_sha256",
        "run_command_id",
        "pe_headers_command_id",
        "pe_dependents_command_id",
        "elf_command_id",
        "ptx_list_command_id",
        "sass_dump_command_id",
        "ptx_dump_command_id",
        "embedded_sass",
        "embedded_ptx",
        "pe_imports",
        "result"
      ],
      "properties": {
        "compile_command_id": { "$ref": "#/definitions/commandId" },
        "executable_sha256": { "$ref": "#/definitions/sha256" },
        "run_command_id": { "$ref": "#/definitions/commandId" },
        "pe_headers_command_id": { "$ref": "#/definitions/commandId" },
        "pe_dependents_command_id": { "$ref": "#/definitions/commandId" },
        "elf_command_id": { "$ref": "#/definitions/commandId" },
        "ptx_list_command_id": { "$ref": "#/definitions/commandId" },
        "sass_dump_command_id": { "$ref": "#/definitions/commandId" },
        "ptx_dump_command_id": { "$ref": "#/definitions/commandId" },
        "embedded_sass": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sm_[0-9]+[a-z]?$" }
        },
        "embedded_ptx": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^compute_[0-9]+[a-z]?$" }
        },
        "pe_imports": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptySingleLine" },
          "allOf": [
            { "contains": { "type": "string", "pattern": "^[Cc][Uu][Bb][Ll][Aa][Ss]64_[0-9]+\\.[Dd][Ll][Ll]$" } },
            { "contains": { "type": "string", "pattern": "^[Cc][Uu][Bb][Ll][Aa][Ss][Ll][Tt]64_[0-9]+\\.[Dd][Ll][Ll]$" } }
          ]
        },
        "result": { "const": "PASS" }
      }
    },
    "mixedArtifact": {
      "allOf": [
        { "$ref": "#/definitions/artifactInspection" },
        {
          "properties": {
            "embedded_sass": { "const": ["sm_120"] },
            "embedded_ptx": { "const": ["compute_120"] }
          }
        }
      ]
    },
    "ptxOnlyArtifact": {
      "allOf": [
        { "$ref": "#/definitions/artifactInspection" },
        {
          "properties": {
            "embedded_sass": { "const": [] },
            "embedded_ptx": { "const": ["compute_120"] }
          }
        }
      ]
    },
