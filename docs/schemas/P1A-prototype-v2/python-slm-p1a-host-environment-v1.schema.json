      "properties": {
        "status": { "const": "PASS" },
        "commands": {
          "const": [
            { "argv": ["cargo", "fmt", "--all", "--", "--check"], "exit_code": 0 },
            { "argv": ["cargo", "clippy", "--locked", "--all-targets", "--features", "cpu-reference", "--", "-D", "warnings"], "exit_code": 0 },
            { "argv": ["cargo", "test", "--locked", "--features", "cpu-reference"], "exit_code": 0 }
          ]
        }
      }
    },
    "toolchainIdentityStability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "before", "after", "stable"],
      "properties": {
        "algorithm": { "const": "sha256-qualified-files-and-selected-trees-v1" },
        "before": { "$ref": "#/definitions/toolchainStabilitySnapshot" },
        "after": { "$ref": "#/definitions/toolchainStabilitySnapshot" },
        "stable": { "const": true }
      }
    },
    "toolchainStabilitySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_manifest_sha256",
        "qualified_file_manifest_sha256",
        "qualified_file_count",
        "qualified_file_total_bytes",
        "msvc_include_tree",
        "msvc_x64_lib_tree",
        "windows_sdk_include_tree",
        "windows_sdk_x64_lib_tree",
        "bundle_sha256"
      ],
      "properties": {
        "selection_manifest_sha256": { "$ref": "#/definitions/sha256" },
        "qualified_file_manifest_sha256": { "$ref": "#/definitions/sha256" },
        "qualified_file_count": { "const": 19 },
        "qualified_file_total_bytes": { "type": "integer", "minimum": 19 },
        "msvc_include_tree": { "$ref": "#/definitions/treeIdentity" },
        "msvc_x64_lib_tree": { "$ref": "#/definitions/treeIdentity" },
        "windows_sdk_include_tree": { "$ref": "#/definitions/treeIdentity" },
        "windows_sdk_x64_lib_tree": { "$ref": "#/definitions/treeIdentity" },
        "bundle_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "treeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "directory_count", "file_count", "total_bytes"],
      "properties": {
        "sha256": { "$ref": "#/definitions/sha256" },
        "directory_count": { "type": "integer", "minimum": 1 },
        "file_count": { "type": "integer", "minimum": 1 },
        "total_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "inputStability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_sha256", "after_sha256", "stable"],
      "properties": {
        "before_sha256": { "$ref": "#/definitions/sha256" },
        "after_sha256": { "$ref": "#/definitions/sha256" },
        "stable": { "const": true }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owned_temp_root_removed",
        "fresh_target_removed",
        "process_job_empty",
        "persistent_state_mutation_requested",
        "persistent_environment_redirected",
        "persistent_environment_removed"
      ],
      "properties": {
        "owned_temp_root_removed": { "const": true },
        "fresh_target_removed": { "const": true },
        "process_job_empty": { "const": true },
        "persistent_state_mutation_requested": { "const": false },
        "persistent_environment_redirected": { "const": true },
        "persistent_environment_removed": { "const": true }
      }
    },
    "deferredAdapters": {
      "const": [
        { "adapter": "linux-host", "status": "DEFERRED_POST_P16", "probed": false },
        { "adapter": "macos-host", "status": "DEFERRED_POST_P16", "probed": false },
        { "adapter": "gcc", "status": "DEFERRED_POST_P16", "probed": false },
        { "adapter": "clang", "status": "DEFERRED_POST_P16", "probed": false },
        { "adapter": "apple-clang", "status": "DEFERRED_POST_P16", "probed": false }
      ]
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "path", "version", "sha256", "bytes", "invocation_mode"],
      "properties": {
        "logical_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
        "path": { "$ref": "#/definitions/tokenizedPath" },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "invocation_mode": { "enum": ["native", "c17", "c++20"] }
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "path", "version", "sha256", "bytes"],
      "properties": {
        "logical_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
        "path": { "$ref": "#/definitions/tokenizedPath" },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "remediation"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "message": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 }
      }
    },
    "errors": { "type": "array", "items": { "$ref": "#/definitions/error" } },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tokenizedPath": {
      "type": "string",
      "pattern": "^\\$\\{(?:RUSTUP_HOME|CARGO_HOME|VS_INSTALL|VC_TOOLS|WINDOWS_KITS|SYSTEM32|PROGRAM_FILES|PROGRAM_FILES_X86)\\}(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9 ._()+-]+)*$"
    }
  }
}
