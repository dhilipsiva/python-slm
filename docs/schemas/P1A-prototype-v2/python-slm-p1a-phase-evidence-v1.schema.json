{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://python-slm.local/schemas/P1A-prototype-v2/python-slm-p1a-phase-evidence-v1.schema.json",
  "title": "python-slm immutable P1A prototype host qualification evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase_id",
    "interface_id",
    "profile_id",
    "support_tier",
    "qualification_scope",
    "qualification_tuple",
    "run_id",
    "status",
    "generated_at_utc",
    "source",
    "p0a_dependency",
    "artifacts",
    "command_plan",
    "commands",
    "redaction",
    "containment",
    "authority",
    "errors",
    "seal"
  ],
  "properties": {
    "schema": { "const": "python-slm-p1a-phase-evidence-v1" },
    "phase_id": { "const": "P1A" },
    "interface_id": { "const": "portable-interface-v2" },
    "profile_id": { "const": "prototype-windows-5090-v1" },
    "support_tier": { "const": "implemented" },
    "qualification_scope": { "const": "host_toolchain_only" },
    "qualification_tuple": { "$ref": "#/definitions/qualificationTuple" },
    "run_id": { "$ref": "#/definitions/runId" },
    "status": { "enum": ["PASS", "FAIL"] },
    "generated_at_utc": { "$ref": "#/definitions/utcDateTime" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "branch", "dirty", "cargo_lock_sha256", "identity_ref"],
      "properties": {
        "commit": { "$ref": "#/definitions/gitSha" },
        "tree": { "$ref": "#/definitions/gitSha" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "dirty": { "const": false },
        "cargo_lock_sha256": { "$ref": "#/definitions/sha256" },
        "identity_ref": {
          "allOf": [
            { "$ref": "#/definitions/fileRef" },
            { "properties": { "path": { "const": "artifacts/source-identity.json" } } }
          ]
        }
      }
    },
    "p0a_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "acceptance_sha256", "run_id", "seal_sha256", "reference"],
      "properties": {
        "status": { "const": "PASS" },
        "acceptance_sha256": { "const": "31434001719f50de1abfa06dd84200ffb8e1f0947e08c8673f6413c08dbc4fb4" },
        "run_id": { "const": "20260813T111427138Z-594485fab70714426a7a3870" },
        "seal_sha256": { "const": "5248bbd6ef45e42480676a978a683a8883e68466804b0cce572af6b368044900" },
        "reference": {
          "allOf": [
            { "$ref": "#/definitions/fileRef" },
            { "properties": { "path": { "const": "artifacts/p0a-dependency.json" } } }
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/artifactRef" }
    },
    "command_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "id_format",
        "first_id",
        "command_count",
        "consecutive_ids",
        "unique_ids",
        "exact_argv_enforced"
      ],
      "properties": {
        "policy_id": { "const": "p1a-command-plan-v1" },
        "id_format": { "const": "C%03u" },
        "first_id": { "const": "C001" },
        "command_count": { "type": "integer", "minimum": 0, "maximum": 29 },
        "consecutive_ids": { "const": true },
        "unique_ids": { "const": true },
        "exact_argv_enforced": { "const": true }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 0,
      "maxItems": 999,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/commandRecord" }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_path_leaks", "username_leaks", "temporary_path_leaks", "environment_secret_leaks", "validated"],
      "properties": {
        "private_path_leaks": { "$ref": "#/definitions/leaks" },
        "username_leaks": { "$ref": "#/definitions/leaks" },
        "temporary_path_leaks": { "$ref": "#/definitions/leaks" },
        "environment_secret_leaks": { "$ref": "#/definitions/leaks" },
        "validated": { "type": "boolean" }
      }
    },
    "containment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_root",
        "owned_staging_root",
        "reparse_points_followed",
        "write_scope_enforcement",
        "owned_temp_root_removed",
        "staging_root_removed",
        "process_jobs_empty"
      ],
      "properties": {
        "output_root": { "const": "docs/receipts/P1A-prototype-v2" },
        "owned_staging_root": { "const": "docs/receipts/P1A-prototype-v2/.staging" },
        "reparse_points_followed": { "type": "boolean" },
        "write_scope_enforcement": { "const": "fixed-argv-cargo-offline-redirected-standard-write-roots-v1" },
        "owned_temp_root_removed": { "type": "boolean" },
        "staging_root_removed": { "type": "boolean" },
        "process_jobs_empty": { "type": "boolean" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine_evidence", "automatic_acceptance_eligible", "required_approvals", "human_checkbox_review"],
      "properties": {
        "machine_evidence": { "enum": ["PASS", "FAIL"] },
        "automatic_acceptance_eligible": { "type": "boolean" },
        "required_approvals": { "const": [] },
        "human_checkbox_review": { "const": "PENDING" }
      }
    },
    "errors": { "$ref": "#/definitions/errors" },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "entries", "coverage_rule"],
      "properties": {
        "path": { "const": "SHA256SUMS" },
        "entries": { "type": "integer", "minimum": 1 },
        "coverage_rule": { "const": "all_run_files_except_seal" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
      "then": {
        "properties": {
          "commands": {
            "minItems": 29,
            "maxItems": 29,
            "items": {
              "allOf": [
                { "$ref": "#/definitions/commandRecord" },
                { "properties": { "exit_code": { "const": 0 }, "status": { "const": "PASS" } } },
                { "properties": { "process_audit": { "$ref": "#/definitions/passProcessAudit" } } }
              ]
            }
          },
          "artifacts": {
            "minItems": 6,
            "maxItems": 6,
            "allOf": [
              { "contains": { "properties": { "path": { "const": "artifacts/source-identity.json" } }, "required": ["path"] } },
              { "contains": { "properties": { "path": { "const": "artifacts/p0a-dependency.json" } }, "required": ["path"] } },
              { "contains": { "properties": { "path": { "const": "artifacts/schema-bundle.json" } }, "required": ["path"] } },
              { "contains": { "properties": { "path": { "const": "artifacts/host-environment.json" } }, "required": ["path"] } },
              { "contains": { "properties": { "path": { "const": "artifacts/cpu-isolation.json" } }, "required": ["path"] } },
              { "contains": { "properties": { "path": { "const": "artifacts/native-abi-probe.json" } }, "required": ["path"] } }
            ]
          },
          "redaction": {
            "properties": {
              "private_path_leaks": { "maxItems": 0 },
              "username_leaks": { "maxItems": 0 },
              "temporary_path_leaks": { "maxItems": 0 },
              "environment_secret_leaks": { "maxItems": 0 },
              "validated": { "const": true }
            }
          },
          "containment": {
            "properties": {
              "reparse_points_followed": { "const": false },
              "write_scope_enforcement": { "const": "fixed-argv-cargo-offline-redirected-standard-write-roots-v1" },
              "owned_temp_root_removed": { "const": true },
        "staging_root_removed": { "const": false },
              "process_jobs_empty": { "const": true }
            }
          },
          "authority": {
            "properties": {
              "machine_evidence": { "const": "PASS" },
              "automatic_acceptance_eligible": { "const": true }
            }
          },
          "errors": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "authority": {
            "properties": {
              "machine_evidence": { "const": "FAIL" },
              "automatic_acceptance_eligible": { "const": false }
            }
          },
          "errors": { "minItems": 1 }
        }
      }
    }
  ],
  "definitions": {
    "qualificationTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "accelerator_provider", "accelerator_device", "memory_model", "backend_identity", "native_ml_library_identity", "sla"],
      "properties": {
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os_family", "architecture", "cpu_vendor", "cpu_model", "rust_target", "c_cpp_toolchain"],
          "properties": {
            "os_family": { "const": "windows" },
            "architecture": { "const": "x86_64" },
            "cpu_vendor": { "const": "AuthenticAMD" },
            "cpu_model": { "const": "AMD Ryzen 9 9950X3D 16-Core Processor" },
            "rust_target": { "const": "x86_64-pc-windows-msvc" },
            "c_cpp_toolchain": { "const": "msvc" }
          }
        },
        "accelerator_provider": { "type": "null" },
        "accelerator_device": { "type": "null" },
        "memory_model": { "type": "null" },
        "backend_identity": { "type": "null" },
        "native_ml_library_identity": { "type": "null" },
        "sla": { "type": "null" }
      }
    },
    "commandRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command_kind",
        "argv",
        "cwd",
        "exit_code",
        "status",
        "started_at_utc",
        "finished_at_utc",
        "duration_ns",
        "network_mode",
        "stdout",
        "stderr",
        "process_audit",
        "execution_error_code"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^C[0-9]{3}$" },
        "command_kind": { "enum": ["git", "non_git"] },
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cwd": { "enum": ["${REPO}", "${P1A_TEMP}"] },
        "exit_code": { "type": "integer" },
        "status": { "enum": ["PASS", "FAIL"] },
        "started_at_utc": { "$ref": "#/definitions/utcDateTime" },
        "finished_at_utc": { "$ref": "#/definitions/utcDateTime" },
        "duration_ns": { "type": "integer", "minimum": 1 },
        "network_mode": { "enum": ["not_applicable", "cargo_offline_enforced"] },
        "stdout": { "$ref": "#/definitions/fileRef" },
        "stderr": { "$ref": "#/definitions/fileRef" },
        "process_audit": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/processAudit" }
          ]
        },
        "execution_error_code": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "command_kind": { "const": "git" } }, "required": ["command_kind"] },
          "then": {
            "properties": {
              "argv": {
                "items": [
                  { "const": "${GIT}" }
                ]
              },
              "network_mode": { "const": "not_applicable" }
            }
          },
          "else": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "argv": {
                      "items": [
                        { "const": "cargo" }
                      ]
                    }
                  },
                  "required": ["argv"]
                },
                "then": { "properties": { "network_mode": { "const": "cargo_offline_enforced" } } },
                "else": { "properties": { "network_mode": { "const": "not_applicable" } } }
              }
            ]
          }
        },
        {
          "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
          "then": {
            "properties": {
              "exit_code": { "const": 0 },
              "process_audit": { "$ref": "#/definitions/passProcessAudit" },
              "execution_error_code": { "type": "null" }
            }
          },
          "else": {
            "oneOf": [
              {
                "properties": {
                  "process_audit": { "$ref": "#/definitions/processAudit" },
                  "execution_error_code": { "type": "null" }
                },
                "allOf": [
                  {
                    "anyOf": [
                      { "properties": { "exit_code": { "not": { "const": 0 } } } },
                      { "properties": { "process_audit": { "not": { "$ref": "#/definitions/passProcessAudit" } } } }
                    ]
                  }
                ]
              },
              {
                "properties": {
                  "exit_code": { "const": -1 },
                  "process_audit": { "type": "null" },
                  "execution_error_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
                }
              }
            ]
          }
        },
        {
          "properties": {
            "stdout": {
              "properties": { "path": { "pattern": "^commands/C[0-9]{3}\\.stdout\\.txt$" } }
            },
            "stderr": {
              "properties": { "path": { "pattern": "^commands/C[0-9]{3}\\.stderr\\.txt$" } }
            }
          }
        }
      ]
    },
    "processAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_method",
        "atomic_job_assignment",
        "root_process_id",
        "root_creation_time_100ns",
        "audited_process_count",
        "covered_process_count",
        "successful_snapshots",
        "exit_races",
        "executable_names",
        "process_identities",
        "loaded_modules",
        "forbidden_processes",
        "forbidden_modules",
        "process_tree_terminated",
        "unexpected_descendants",
        "qualified_tool_descendants_cleaned",
        "timed_out"
      ],
      "properties": {
        "audit_method": { "const": "windows_job_object_toolhelp32_v1" },
        "atomic_job_assignment": { "type": "boolean" },
        "root_process_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "root_creation_time_100ns": { "type": "integer", "minimum": 1 },
        "audited_process_count": { "type": "integer", "minimum": 0 },
        "covered_process_count": { "type": "integer", "minimum": 0 },
        "successful_snapshots": { "type": "integer", "minimum": 0 },
        "exit_races": { "type": "integer", "minimum": 0 },
        "executable_names": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "process_identities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/auditedProcessIdentity" }
        },
        "loaded_modules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/loadedModuleIdentity" }
        },
        "forbidden_processes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_modules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "process_tree_terminated": { "type": "boolean" },
        "unexpected_descendants": { "type": "boolean" },
        "qualified_tool_descendants_cleaned": { "type": "boolean" },
        "timed_out": { "type": "boolean" }
      }
    },
    "passProcessAudit": {
      "allOf": [
        { "$ref": "#/definitions/processAudit" },
        {
          "properties": {
            "atomic_job_assignment": { "const": true },
            "audited_process_count": { "minimum": 1 },
            "covered_process_count": { "minimum": 1 },
            "successful_snapshots": { "minimum": 1 },
            "exit_races": { "const": 0 },
            "executable_names": { "minItems": 1 },
            "process_identities": { "minItems": 1 },
            "loaded_modules": { "minItems": 1 },
            "forbidden_processes": { "maxItems": 0 },
            "forbidden_modules": { "maxItems": 0 },
            "process_tree_terminated": { "const": true },
            "unexpected_descendants": { "const": false },
            "timed_out": { "const": false }
          }
        }
      ]
    },
    "auditedProcessIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_id",
        "creation_time_100ns",
        "executable_name",
        "canonical_path_sha256",
        "executable_sha256",
        "executable_bytes",
        "path_class"
      ],
      "properties": {
        "process_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "creation_time_100ns": { "type": "integer", "minimum": 1 },
        "executable_name": { "type": "string", "pattern": "^[^\\\\/]+\\.exe$" },
        "canonical_path_sha256": { "$ref": "#/definitions/sha256" },
        "executable_sha256": { "$ref": "#/definitions/sha256" },
        "executable_bytes": { "type": "integer", "minimum": 1 },
        "path_class": { "$ref": "#/definitions/auditedPathClass" }
      }
    },
    "loadedModuleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_id",
        "creation_time_100ns",
        "module_name",
        "canonical_path_sha256",
        "module_sha256",
        "module_bytes",
        "path_class"
      ],
      "properties": {
        "process_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "creation_time_100ns": { "type": "integer", "minimum": 1 },
        "module_name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\\\/]+$" },
        "canonical_path_sha256": { "$ref": "#/definitions/sha256" },
        "module_sha256": { "$ref": "#/definitions/sha256" },
        "module_bytes": { "type": "integer", "minimum": 1 },
        "path_class": { "$ref": "#/definitions/auditedPathClass" }
      }
    },
    "auditedPathClass": {
      "enum": [
        "windows_system32",
        "windows_syswow64",
        "root_tool_directory",
        "qualified_tool_file",
        "qualified_tool_root",
        "qualified_working_tree"
      ]
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "$ref": "#/definitions/relativePath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "artifactRef": {
      "allOf": [
        { "$ref": "#/definitions/fileRef" },
        {
          "properties": {
            "path": {
              "enum": [
                "artifacts/source-identity.json",
                "artifacts/p0a-dependency.json",
                "artifacts/schema-bundle.json",
                "artifacts/host-environment.json",
                "artifacts/cpu-isolation.json",
                "artifacts/native-abi-probe.json"
              ]
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "message", "remediation"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "category": { "enum": ["internal", "usage", "integrity", "environment", "gate"] },
        "message": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 }
      }
    },
    "errors": { "type": "array", "items": { "$ref": "#/definitions/error" } },
    "leaks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{9}Z-[0-9a-f]{24}$" },
    "utcDateTime": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_$(){}+-][A-Za-z0-9._$(){}+-]*(?:/[A-Za-z0-9_$(){}+-][A-Za-z0-9._$(){}+-]*)*$"
    }
  }
}
